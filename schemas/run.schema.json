{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deweyou/harness/schemas/run.schema.json",
  "title": "Deweyou Harness run metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "workspace", "createdAt", "hostSessions"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "minLength": 1 },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "workspacePath": { "type": "string", "minLength": 1 },
    "workspaceMount": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "hostSessions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  }
}
