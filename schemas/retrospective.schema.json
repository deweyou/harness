{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deweyou/harness/schemas/retrospective.schema.json",
  "title": "Deweyou Harness Run retrospective",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "runId", "createdAt", "observations", "proposalIds"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^retro_[a-f0-9]{20}$" },
    "runId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eventId", "resourceId", "category", "summary"],
        "properties": {
          "eventId": { "type": "string", "minLength": 1 },
          "resourceId": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "proposalIds": { "type": "array", "items": { "type": "string", "pattern": "^proposal_[a-f0-9]{20}$" }, "uniqueItems": true }
  }
}
