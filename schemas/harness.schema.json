{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deweyou/harness/schemas/harness.schema.json",
  "title": "Deweyou Harness configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 3 },
    "strategy": { "enum": ["branch", "worktree"], "default": "branch" },
    "imports": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/relativePath" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "$ref": "#/$defs/relativePath" },
              "as": { "$ref": "#/$defs/id" }
            }
          }
        ]
      }
    },
    "context": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/resource" }
    },
    "skills": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/resource" }
    },
    "nodes": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\]).+"
    },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "stringSet": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "$ref": "#/$defs/resourceSource" }
      }
    },
    "resourceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "entry": { "$ref": "#/$defs/relativePath" }
      }
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "description"],
          "properties": {
            "kind": { "const": "agent" },
            "description": { "type": "string", "minLength": 1 },
            "skill": { "$ref": "#/$defs/stringSet" },
            "inputs": { "$ref": "#/$defs/portMap" },
            "outputs": { "$ref": "#/$defs/portMap" },
            "authority": { "$ref": "#/$defs/stringSet" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "command", "description"],
          "properties": {
            "kind": { "const": "command" },
            "command": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "inputs": { "$ref": "#/$defs/portMap" },
            "outputs": { "$ref": "#/$defs/portMap" },
            "authority": { "$ref": "#/$defs/stringSet" }
          }
        }
      ]
    },
    "portMap": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "description": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    }
  }
}
