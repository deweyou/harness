{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deweyou/harness/schemas/harness.schema.json",
  "title": "Deweyou Harness v2 configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 2 },
    "imports": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "as": { "$ref": "#/$defs/id" }
            }
          }
        ]
      }
    },
    "resources": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/resource" }
    },
    "nodes": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "stringSet": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source"],
      "properties": {
        "kind": { "enum": ["skill", "rule", "knowledge"] },
        "description": { "type": "string", "minLength": 1 },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "path"],
              "properties": { "type": { "const": "workspace" }, "path": { "type": "string", "minLength": 1 } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "repo", "skill"],
              "properties": {
                "type": { "const": "registry" },
                "repo": { "type": "string", "minLength": 1 },
                "skill": { "type": "string", "minLength": 1 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "repo", "path"],
              "properties": {
                "type": { "const": "git" },
                "repo": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "minLength": 1 },
                "ref": { "type": "string", "minLength": 1 }
              }
            }
          ]
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executor"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "resources": { "$ref": "#/$defs/stringSet" },
        "inputs": { "$ref": "#/$defs/stringSet" },
        "outputs": { "$ref": "#/$defs/stringSet" },
        "claimTypes": { "$ref": "#/$defs/stringSet" },
        "artifactTypes": { "$ref": "#/$defs/stringSet" },
        "authority": { "$ref": "#/$defs/stringSet" },
        "executionPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["idempotent"],
          "properties": {
            "idempotent": { "type": "boolean" },
            "timeoutMs": { "type": "integer", "minimum": 1 },
            "retry": {
              "type": "object",
              "additionalProperties": false,
              "required": ["maxAttempts"],
              "properties": {
                "maxAttempts": { "type": "integer", "minimum": 1 },
                "backoffMs": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        "executor": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": {
                "kind": { "const": "agent" },
                "skills": { "$ref": "#/$defs/stringSet" },
                "config": { "type": "object" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "argv"],
              "properties": {
                "kind": { "const": "command" },
                "argv": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                "cwd": { "type": "string", "minLength": 1 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "capability"],
              "properties": {
                "kind": { "const": "capability" },
                "capability": { "type": "string", "minLength": 1 },
                "config": { "type": "object" }
              }
            }
          ]
        }
      }
    }
  }
}
