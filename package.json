{
  "name": "deweyou-harness",
  "version": "1.0.0",
  "type": "module",
  "description": "A config-driven, domain-neutral workflow harness for coding agents",
  "private": true,
  "author": "Dewey Ou <oushihao97@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deweyou/harness.git"
  },
  "openclaw": {
    "extensions": [
      "./adapters/openclaw/index.mjs"
    ]
  },
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "vp pack src/mcp/server.ts --out-dir dist --clean && node scripts/normalize-bundle.mjs",
    "pretest": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint:assets": "node scripts/lint-assets.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "test": "vitest run",
    "pretest:coverage": "pnpm run build",
    "test:coverage": "vitest run --coverage",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "check": "pnpm run lint:assets && pnpm run typecheck && pnpm test && pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "js-yaml": "^4.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.0",
    "@vitest/coverage-v8": "4.1.8",
    "typescript": "^6.0.0",
    "vite-plus": "^0.1.21",
    "vitest": "4.1.8"
  },
  "packageManager": "pnpm@10.33.0"
}
